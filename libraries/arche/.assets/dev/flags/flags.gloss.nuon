[
  {snake: actor, summary: "Marks an object as a living creature, so combat, give, and talk verbs accept it as a target.", scope: []},
  {snake: burn, summary: "Marks an object as flammable, so it can be set alight and consumed by burning.", scope: []},
  {snake: climb, summary: "Marks an object that can be climbed up, down, or on.", scope: []},
  {snake: container, summary: "Marks an object that can hold other objects inside it.", scope: []},
  {snake: door, summary: "Marks an object as a door or lid that can be opened and closed.", scope: []},
  {snake: drink, summary: "Marks an object that can be drunk.", scope: []},
  {snake: fighting, summary: "Tracks that a creature is currently engaged in active combat, set and cleared as fights begin and end.", scope: [actor]},
  {snake: flame, summary: "Marks an object that is currently burning with an open flame usable to light or ignite other things.", scope: [object]},
  {snake: food, summary: "Marks an object that can be eaten.", scope: []},
  {snake: invisible, summary: "Hides an object from the player, excluding it from room listings and parser resolution until revealed.", scope: [object]},
  {snake: light_source, summary: "Marks an object that is a controllable lamp able to be turned on and off.", scope: [object]},
  {snake: maze, summary: "Marks a room as part of the maze, altering navigation and the thief's roaming behavior there.", scope: []},
  {snake: no_description, summary: "Suppresses the automatic mention of an object in a room's contents listing.", scope: [object]},
  {snake: non_land, summary: "Marks a room as water rather than dry land, requiring a watercraft to occupy it.", scope: [room]},
  {snake: nwall, summary: "Zork II room marker; appears only in room FLAGS and is never tested in the preserved source, so its purpose is unrecorded.", scope: []},
  {snake: lighting, summary: "Tracks that a lamp or room is currently lit or switched on.", scope: [room, object]},
  {snake: open, summary: "Tracks that a door or container is currently open.", scope: [object]},
  {snake: read, summary: "Marks an object bearing text that can be read.", scope: [object]},
  {snake: land, summary: "Marks a room as dry land that can be entered on foot.", scope: [room]},
  {snake: mung, summary: "Marks a room or object as destroyed or ruined, replacing its normal description and disabling its function.", scope: [room, object]},
  {snake: sacred, summary: "Protects a room or object from the thief, who will neither enter it nor steal from it.", scope: [room, object]},
  {snake: search, summary: "Marks an object whose contents are revealed when it is searched or looked inside.", scope: []},
  {snake: staggered, summary: "Tracks that a combatant is reeling from a blow and loses its next turn, cleared once that turn passes.", scope: [actor]},
  {snake: surface, summary: "Marks an object as a surface that other objects can be placed on top of.", scope: []},
  {snake: take, summary: "Marks an object that the player can pick up and carry.", scope: [object]},
  {snake: tool, summary: "Marks an object usable as an instrument for actions such as digging, prying, locking, or turning.", scope: []},
  {snake: touch, summary: "Tracks that a room has been visited or an object disturbed, distinguishing first encounters from later ones.", scope: [room, object]},
  {snake: transparent, summary: "Marks a container whose contents are visible even while it is closed.", scope: []},
  {snake: try_take, summary: "Marks an object the parser will attempt to pick up automatically before a verb that needs it held.", scope: [object]},
  {snake: turn, summary: "Marks an object that can be turned, such as a switch, dial, or bolt.", scope: []},
  {snake: vehicle, summary: "Marks an object that can be boarded and ridden, carrying the player between rooms.", scope: [object]},
  {snake: victim, summary: "Marks an object as a valid victim/target for attack-style verbs like KNOCK DOWN, in Zork III.", scope: []},
  {snake: weapon, summary: "Marks an object usable as a weapon in combat.", scope: [object]},
  {snake: wear, summary: "Marks an object that can be worn.", scope: []}
]