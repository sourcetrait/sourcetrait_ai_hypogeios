    {rid: "INSTR", desc2: "Stream", desc1: "You are on the gently flowing stream.  The upstream route is too narrow\nto navigate and the downstream route is invisible due to twisting\nwalls.  There is a narrow beach to land on.", exits: [{dir: "Up", to: {kind: "nexit", msg: "The way is too narrow."}}, {dir: "Land", to: {kind: "room", to: "STREA"}}, {dir: "Down", to: {kind: "room", to: "RESER"}}], contents: [], roomf: null, rbits: ["rwaterbit", "rnwallbit"], rglobal: ["rgwater"]},
    {rid: "EGYPT", desc2: "Egyptian Room", desc1: "This is a room which looks like an Egyptian tomb.  There is an\nascending staircase in the room as well as doors, east and south.", exits: [{dir: "Up", to: {kind: "room", to: "ICY"}}, {dir: "South", to: {kind: "room", to: "LEDG3"}}, {dir: "East", to: {kind: "cexit", flag: "egypt_flag", to: "CRAW1", msg: "The passage is too narrow to accommodate coffins.", fn: "coffin_cure"}}], contents: ["COFFI"], roomf: null, rbits: ["rlandbit"]},
    {rid: "ICY", desc2: "Glacier Room", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "STREA"}}, {dir: "East", to: {kind: "room", to: "EGYPT"}}, {dir: "West", to: {kind: "cexit", flag: "glacier_flag", to: "RUBYR", msg: "", fn: null}}], contents: ["ICE"], roomf: "glacier_room", rbits: ["rlandbit"]},
    {rid: "RUBYR", desc2: "Ruby Room", desc1: "This is a small chamber behind the remains of the Great Glacier.\nTo the south and west are small passageways.", exits: [{dir: "West", to: {kind: "room", to: "LAVA"}}, {dir: "South", to: {kind: "room", to: "ICY"}}], contents: ["RUBY"], roomf: null, rbits: ["rlandbit"]},
    {rid: "ATLAN", desc2: "Atlantis Room", desc1: "This is an ancient room, long under water.  There are exits here\nto the southeast and upward.", exits: [{dir: "Se", to: {kind: "room", to: "RESEN"}}, {dir: "Up", to: {kind: "room", to: "CAVE1"}}], contents: ["TRIDE"], roomf: null, rbits: ["rlandbit"]},
    {rid: "CANY1", desc2: "Deep Canyon", desc1: "You are on the south edge of a deep canyon.  Passages lead off\nto the east, south, and northwest.  You can hear the sound of\nflowing water below.", exits: [{dir: "Nw", to: {kind: "cexit", flag: "egypt_flag", to: "RESES", msg: "The passage is too steep for carrying the coffin.", fn: "coffin_cure"}}, {dir: "East", to: {kind: "room", to: "DAM"}}, {dir: "South", to: {kind: "room", to: "CAROU"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "ECHO", desc2: "Loud Room", desc1: "This is a large room with a ceiling which cannot be detected from\nthe ground. There is a narrow passage from east to west and a stone\nstairway leading upward.  The room is extremely noisy.  In fact, it is\ndifficult to hear yourself think.", exits: [{dir: "East", to: {kind: "room", to: "CHAS3"}}, {dir: "West", to: {kind: "room", to: "PASS5"}}, {dir: "Up", to: {kind: "room", to: "CAVE3"}}], contents: ["BAR"], roomf: "echo_room", rbits: ["rlandbit"]},
    {rid: "MIRR1", desc2: "Mirror Room", desc1: "", exits: [{dir: "West", to: {kind: "room", to: "PASS3"}}, {dir: "North", to: {kind: "room", to: "CRAW2"}}, {dir: "East", to: {kind: "room", to: "CAVE1"}}], contents: ["REFL1"], roomf: "mirror_room", rbits: ["rlandbit"]},
    {rid: "MIRR2", desc2: "Mirror Room", desc1: "", exits: [{dir: "West", to: {kind: "room", to: "PASS4"}}, {dir: "North", to: {kind: "room", to: "CRAW3"}}, {dir: "East", to: {kind: "room", to: "CAVE2"}}], contents: ["REFL2"], roomf: "mirror_room", rbits: ["rlandbit", "rlightbit"]},
    {rid: "CAVE1", desc2: "Cave", desc1: "This is a small cave with an entrance to the north and a stairway\nleading down.", exits: [{dir: "North", to: {kind: "room", to: "MIRR1"}}, {dir: "Down", to: {kind: "room", to: "ATLAN"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CAVE2", desc2: "Cave", desc1: "This is a tiny cave with entrances west and north, and a dark,\nforbidding staircase leading down.", exits: [{dir: "North", to: {kind: "room", to: "CRAW3"}}, {dir: "West", to: {kind: "room", to: "MIRR2"}}, {dir: "Down", to: {kind: "room", to: "LLD1"}}], contents: [], roomf: "cave2_room", rbits: ["rlandbit"]},
    {rid: "CRAW2", desc2: "Steep Crawlway", desc1: "This is a steep and narrow crawlway.  There are two exits nearby to\nthe south and southwest.", exits: [{dir: "South", to: {kind: "room", to: "MIRR1"}}, {dir: "Sw", to: {kind: "room", to: "PASS3"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CRAW3", desc2: "Narrow Crawlway", desc1: "This is a narrow crawlway.  The crawlway leads from north to south.\nHowever the south passage divides to the south and southwest.", exits: [{dir: "South", to: {kind: "room", to: "CAVE2"}}, {dir: "Sw", to: {kind: "room", to: "MIRR2"}}, {dir: "North", to: {kind: "room", to: "MGRAI"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "PASS3", desc2: "Cold Passage", desc1: "This is a cold and damp corridor where a long east-west passageway\nintersects with a northward path.", exits: [{dir: "East", to: {kind: "room", to: "MIRR1"}}, {dir: "West", to: {kind: "room", to: "SLIDE"}}, {dir: "North", to: {kind: "room", to: "CRAW2"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "PASS4", desc2: "Winding Passage", desc1: "This is a winding passage.  It seems that there is only an exit\non the east end although the whirring from the round room can be\nheard faintly to the north.", exits: [{dir: "East", to: {kind: "room", to: "MIRR2"}}, {dir: "North", to: {kind: "nexit", msg: "You hear the whir from the round room but can find no entrance."}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "ENTRA", desc2: "Mine Entrance", desc1: "You are standing at the entrance of what might have been a coal\nmine. To the northeast and the northwest are entrances to the mine,\nand there is another exit on the south end of the room.", exits: [{dir: "South", to: {kind: "room", to: "SLIDE"}}, {dir: "Nw", to: {kind: "room", to: "SQUEE"}}, {dir: "Ne", to: {kind: "room", to: "TSHAF"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "SQUEE", desc2: "Squeaky Room", desc1: "You are a small room.  Strange squeaky sounds may be heard coming from\nthe passage at the west end.  You may also escape to the south.", exits: [{dir: "West", to: {kind: "room", to: "BATS"}}, {dir: "South", to: {kind: "room", to: "ENTRA"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "TSHAF", desc2: "Shaft Room", desc1: "This is a large room, in the middle of which is a small shaft\ndescending through the floor into darkness below.  To the west and\nthe north are exits from this room.  Constructed over the top of the\nshaft is a metal framework to which a heavy iron chain is attached.", exits: [{dir: "Down", to: {kind: "nexit", msg: "You wouldn't fit and would die if you could."}}, {dir: "West", to: {kind: "room", to: "ENTRA"}}, {dir: "North", to: {kind: "room", to: "TUNNE"}}], contents: ["TBASK"], roomf: null, rbits: ["rlandbit"]},
    {rid: "TUNNE", desc2: "Wooden Tunnel", desc1: "This is a narrow tunnel with large wooden beams running across\nthe ceiling and around the walls.  A path from the south splits into\npaths running west and northeast.", exits: [{dir: "South", to: {kind: "room", to: "TSHAF"}}, {dir: "West", to: {kind: "room", to: "SMELL"}}, {dir: "Ne", to: {kind: "room", to: "MINE1"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "SMELL", desc2: "Smelly Room", desc1: "This is a small non-descript room.  However, from the direction\nof a small descending staircase a foul odor can be detected.  To the\neast is a narrow path.", exits: [{dir: "Down", to: {kind: "room", to: "BOOM"}}, {dir: "East", to: {kind: "room", to: "TUNNE"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "BOOM", desc2: "Gas Room", desc1: "This is a small room which smells strongly of coal gas.", exits: [{dir: "Up", to: {kind: "room", to: "SMELL"}}], contents: ["BRACE"], roomf: "boom_room", rbits: ["rlandbit", "rsacredbit"]},
    {rid: "TLADD", desc2: "Ladder Top", desc1: "This is a very small room.  In the corner is a rickety wooden\nladder, leading downward.  It might be safe to descend.  There is\nalso a staircase leading upward.", exits: [{dir: "Down", to: {kind: "room", to: "BLADD"}}, {dir: "Up", to: {kind: "room", to: "MINE7"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "BLADD", desc2: "Ladder Bottom", desc1: "This is a rather wide room.  On one side is the bottom of a\nnarrow wooden ladder.  To the northeast and the south are passages\nleaving the room.", exits: [{dir: "Ne", to: {kind: "room", to: "DEAD7"}}, {dir: "South", to: {kind: "room", to: "TIMBE"}}, {dir: "Up", to: {kind: "room", to: "TLADD"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "DEAD7", desc2: "Dead End", desc1: "Dead End", exits: [{dir: "South", to: {kind: "room", to: "BLADD"}}], contents: ["COAL"], roomf: null, rbits: ["rlandbit"]},
    {rid: "TIMBE", desc2: "Timber Room", desc1: "This is a long and narrow passage, which is cluttered with broken\ntimbers.  A wide passage comes from the north and turns at the \nsouthwest corner of the room into a very narrow passageway.", exits: [{dir: "North", to: {kind: "room", to: "BLADD"}}, {dir: "Sw", to: {kind: "cexit", flag: "\"dark_room\"", to: null, msg: "", fn: null}}], contents: ["OTIMB"], roomf: "no_objs", rbits: ["rlandbit", "rsacredbit"]},
    {rid: "BSHAF", desc2: "Lower Shaft", desc1: "This is a small square room which is at the bottom of a long\nshaft. To the east is a passageway and to the northeast a very narrow\npassage. In the shaft can be seen a heavy iron chain.", exits: [{dir: "East", to: {kind: "room", to: "MACHI"}}, {dir: "Out", to: {kind: "cexit", flag: "empty_handed", to: "TIMBE", msg: "You cannot fit through this passage with that load.", fn: null}}, {dir: "Ne", to: {kind: "cexit", flag: "empty_handed", to: "TIMBE", msg: "You cannot fit through this passage with that load.", fn: null}}, {dir: "Up", to: {kind: "nexit", msg: "The chain is not climbable."}}], contents: ["FBASK"], roomf: "no_objs", rbits: ["rlandbit", "rsacredbit"]},
    {rid: "MACHI", desc2: "Machine Room", desc1: "", exits: [{dir: "Nw", to: {kind: "room", to: "BSHAF"}}], contents: ["MSWIT", "MACHI"], roomf: "machine_room", rbits: ["rlandbit"]},
    {rid: "BATS", desc2: "Bat Room", desc1: "", exits: [{dir: "East", to: {kind: "room", to: "SQUEE"}}], contents: ["JADE", "BAT"], roomf: "bats_room", rbits: ["rlandbit", "rsacredbit"]},
    {rid: "MINE1", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "North", to: {kind: "room", to: "MINE4"}}, {dir: "Sw", to: {kind: "room", to: "MINE2"}}, {dir: "East", to: {kind: "room", to: "TUNNE"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE2", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "South", to: {kind: "room", to: "MINE1"}}, {dir: "West", to: {kind: "room", to: "MINE5"}}, {dir: "Up", to: {kind: "room", to: "MINE3"}}, {dir: "Ne", to: {kind: "room", to: "MINE4"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE3", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "West", to: {kind: "room", to: "MINE2"}}, {dir: "Ne", to: {kind: "room", to: "MINE5"}}, {dir: "East", to: {kind: "room", to: "MINE5"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE4", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "Up", to: {kind: "room", to: "MINE5"}}, {dir: "Ne", to: {kind: "room", to: "MINE6"}}, {dir: "South", to: {kind: "room", to: "MINE1"}}, {dir: "West", to: {kind: "room", to: "MINE2"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE5", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "Down", to: {kind: "room", to: "MINE6"}}, {dir: "North", to: {kind: "room", to: "MINE7"}}, {dir: "West", to: {kind: "room", to: "MINE2"}}, {dir: "South", to: {kind: "room", to: "MINE3"}}, {dir: "Up", to: {kind: "room", to: "MINE3"}}, {dir: "East", to: {kind: "room", to: "MINE4"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE6", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "Se", to: {kind: "room", to: "MINE4"}}, {dir: "Up", to: {kind: "room", to: "MINE5"}}, {dir: "Nw", to: {kind: "room", to: "MINE7"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MINE7", desc2: "Coal mine", desc1: "This is a non-descript part of a coal mine.", exits: [{dir: "East", to: {kind: "room", to: "MINE1"}}, {dir: "West", to: {kind: "room", to: "MINE5"}}, {dir: "Down", to: {kind: "room", to: "TLADD"}}, {dir: "South", to: {kind: "room", to: "MINE6"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "DOME", desc2: "Dome Room", desc1: "", exits: [{dir: "East", to: {kind: "room", to: "CRAW1"}}, {dir: "Down", to: {kind: "cexit", flag: "dome_flag", to: "MTORC", msg: "You cannot go down without fracturing many bones.", fn: null}}], contents: ["RAILI"], roomf: "dome_room", rbits: ["rlandbit"]},
    {rid: "MTORC", desc2: "Torch Room", desc1: "", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot reach the rope."}}, {dir: "West", to: {kind: "room", to: "PRM"}}, {dir: "Down", to: {kind: "room", to: "CRAW4"}}], contents: ["TORCH"], roomf: "torch_room", rbits: ["rlandbit"]},
    {rid: "CRAW4", desc2: "North-South Crawlway", desc1: "This is a north-south crawlway; a passage goes to the east also.\nThere is a hole above, but it provides no opportunities for climbing.", exits: [{dir: "North", to: {kind: "room", to: "CHAS2"}}, {dir: "South", to: {kind: "room", to: "STUDI"}}, {dir: "East", to: {kind: "room", to: "MTROL"}}, {dir: "Up", to: {kind: "nexit", msg: "Not even a human fly could get up it."}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CHAS2", desc2: "West of Chasm", desc1: "You are on the west edge of a chasm, the bottom of which cannot be\nseen. The east side is sheer rock, providing no exits.  A narrow\npassage goes west, and the path you are on continues to the north and\nsouth.", exits: [{dir: "West", to: {kind: "room", to: "CELLA"}}, {dir: "North", to: {kind: "room", to: "CRAW4"}}, {dir: "South", to: {kind: "room", to: "GALLE"}}, {dir: "Down", to: {kind: "nexit", msg: "The chasm probably leads straight to the infernal regions."}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "PASS1", desc2: "East-West Passage", desc1: "This is a narrow east-west passageway.  There is a narrow stairway\nleading down at the north end of the room.", exits: [{dir: "East", to: {kind: "room", to: "CAROU"}}, {dir: "West", to: {kind: "room", to: "MTROL"}}, {dir: "Down", to: {kind: "room", to: "RAVI1"}}, {dir: "North", to: {kind: "room", to: "RAVI1"}}], contents: [], roomf: null, rbits: ["rlandbit"], rval: 5},
    {rid: "CAROU", desc2: "Round room", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "carousel_flip", to: "CAVE4", msg: "", fn: "carousel_exit"}}, {dir: "South", to: {kind: "cexit", flag: "carousel_flip", to: "CAVE4", msg: "", fn: "carousel_exit"}}, {dir: "East", to: {kind: "cexit", flag: "carousel_flip", to: "MGRAI", msg: "", fn: "carousel_exit"}}, {dir: "West", to: {kind: "cexit", flag: "carousel_flip", to: "PASS1", msg: "", fn: "carousel_exit"}}, {dir: "Nw", to: {kind: "cexit", flag: "carousel_flip", to: "CANY1", msg: "", fn: "carousel_exit"}}, {dir: "Ne", to: {kind: "cexit", flag: "carousel_flip", to: "PASS5", msg: "", fn: "carousel_exit"}}, {dir: "Se", to: {kind: "cexit", flag: "carousel_flip", to: "PASS4", msg: "", fn: "carousel_exit"}}, {dir: "Sw", to: {kind: "cexit", flag: "carousel_flip", to: "MAZE1", msg: "", fn: "carousel_exit"}}, {dir: "Exit", to: {kind: "cexit", flag: "carousel_flip", to: "PASS3", msg: "", fn: "carousel_out"}}], contents: ["IRBOX"], roomf: "carousel_room", rbits: ["rlandbit"]},
    {rid: "PASS5", desc2: "North-South Passage", desc1: "This is a high north-south passage, which forks to the northeast.", exits: [{dir: "North", to: {kind: "room", to: "CHAS1"}}, {dir: "Ne", to: {kind: "room", to: "ECHO"}}, {dir: "South", to: {kind: "room", to: "CAROU"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CHAS1", desc2: "Chasm", desc1: "A chasm runs southwest to northeast.  You are on the south edge; the\npath exits to the south and to the east.", exits: [{dir: "South", to: {kind: "room", to: "RAVI1"}}, {dir: "East", to: {kind: "room", to: "PASS5"}}, {dir: "Down", to: {kind: "nexit", msg: "Are you out of your mind?"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CAVE3", desc2: "Damp Cave", desc1: "This is a cave.  Passages exit to the south and to the east, but\nthe cave narrows to a crack to the west.  The earth is particularly\ndamp here.", exits: [{dir: "South", to: {kind: "room", to: "ECHO"}}, {dir: "East", to: {kind: "room", to: "DAM"}}, {dir: "West", to: {kind: "nexit", msg: "It is too narrow for most insects."}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CHAS3", desc2: "Ancient Chasm", desc1: "A chasm, evidently produced by an ancient river, runs through the\ncave here.  Passages lead off in all directions.", exits: [{dir: "South", to: {kind: "room", to: "ECHO"}}, {dir: "East", to: {kind: "room", to: "TCAVE"}}, {dir: "North", to: {kind: "room", to: "DEAD5"}}, {dir: "West", to: {kind: "room", to: "DEAD6"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "DEAD5", desc2: "Dead End", desc1: "Dead End", exits: [{dir: "Sw", to: {kind: "room", to: "CHAS3"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "DEAD6", desc2: "Dead End", desc1: "Dead End", exits: [{dir: "East", to: {kind: "room", to: "CHAS3"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "CAVE4", desc2: "Engravings Cave", desc1: "You have entered a cave with passages leading north and southeast.", exits: [{dir: "North", to: {kind: "room", to: "CAROU"}}, {dir: "Se", to: {kind: "room", to: "RIDDL"}}], contents: ["ENGRA"], roomf: null, rbits: ["rlandbit"]},
    {rid: "RIDDL", desc2: "Riddle Room", desc1: "This is a room which is bare on all sides.  There is an exit down. \nTo the east is a great door made of stone.  Above the stone, the\nfollowing words are written: 'No man shall enter this room without\nsolving this riddle:\n\n  What is tall as a house,\n\t  round as a cup, \n\t  and all the king's horses can't draw it up?'\n\n(Reply via 'ANSWER \"answer\"')", exits: [{dir: "Down", to: {kind: "room", to: "CAVE4"}}, {dir: "East", to: {kind: "cexit", flag: "riddle_flag", to: "MPEAR", msg: "Your way is blocked by an invisible force.", fn: null}}], contents: ["SDOOR"], roomf: null, rbits: ["rlandbit"]},
    {rid: "MPEAR", desc2: "Pearl Room", desc1: "This is a former broom closet.  The exits are to the east and west.", exits: [{dir: "East", to: {kind: "room", to: "BWELL"}}, {dir: "West", to: {kind: "room", to: "RIDDL"}}], contents: ["PEARL"], roomf: null, rbits: ["rlandbit"]},
    {rid: "LLD1", desc2: "Entrance to Hades", desc1: "", exits: [{dir: "East", to: {kind: "cexit", flag: "lld_flag", to: "LLD2", msg: "Some invisible force prevents you from passing through the gate.", fn: null}}, {dir: "Up", to: {kind: "room", to: "CAVE2"}}, {dir: "Enter", to: {kind: "cexit", flag: "lld_flag", to: "LLD2", msg: "Some invisible force prevents you from passing through the gate.", fn: null}}], contents: ["CORPS", "GATES", "GHOST"], roomf: "lld_room", rbits: ["rlandbit", "rlightbit"]},
    {rid: "LLD2", desc2: "Land of the Living Dead", desc1: "", exits: [{dir: "East", to: {kind: "room", to: "TOMB"}}, {dir: "Exit", to: {kind: "room", to: "LLD1"}}, {dir: "West", to: {kind: "room", to: "LLD1"}}], contents: ["BODIE"], roomf: "lld2_room", rbits: ["rlandbit", "rlightbit"], rval: 30},
    {rid: "MGRAI", desc2: "Grail Room", desc1: "You are standing in a small circular room with a pedestal.  A set of\nstairs leads up, and passages leave to the east and west.", exits: [{dir: "West", to: {kind: "room", to: "CAROU"}}, {dir: "East", to: {kind: "room", to: "CRAW3"}}, {dir: "Up", to: {kind: "room", to: "TEMP1"}}], contents: ["GRAIL"], roomf: null, rbits: ["rlandbit"]},
    {rid: "TEMP1", desc2: "Temple", desc1: "This is the west end of a large temple.  On the south wall is an \nancient inscription, probably a prayer in a long-forgotten language. \nThe north wall is solid granite.  The entrance at the west end of the\nroom is through huge marble pillars.", exits: [{dir: "West", to: {kind: "room", to: "MGRAI"}}, {dir: "East", to: {kind: "room", to: "TEMP2"}}], contents: ["PRAYE", "BELL"], roomf: null, rbits: ["rlandbit", "rlightbit", "rsacredbit"]},
    {rid: "TEMP2", desc2: "Altar", desc1: "This is the east end of a large temple.  In front of you is what\nappears to be an altar.", exits: [{dir: "West", to: {kind: "room", to: "TEMP1"}}], contents: ["BOOK", "CANDL"], roomf: null, rbits: ["rlandbit", "rlightbit", "rsacredbit"]},
    {rid: "DAM", desc2: "Dam", desc1: "", exits: [{dir: "South", to: {kind: "room", to: "CANY1"}}, {dir: "Down", to: {kind: "room", to: "DOCK"}}, {dir: "East", to: {kind: "room", to: "CAVE3"}}, {dir: "North", to: {kind: "room", to: "LOBBY"}}], contents: ["BOLT", "DAM", "BUBBL", "CPANL"], roomf: "dam_room", rbits: ["rlandbit", "rlightbit"], rglobal: ["rgwater"]},
    {rid: "LOBBY", desc2: "Dam Lobby", desc1: "This room appears to have been the waiting room for groups touring\nthe dam.  There are exits here to the north and east marked\n'Private', though the doors are open, and an exit to the south.", exits: [{dir: "South", to: {kind: "room", to: "DAM"}}, {dir: "North", to: {kind: "room", to: "MAINT"}}, {dir: "East", to: {kind: "room", to: "MAINT"}}], contents: ["MATCH", "GUIDE"], roomf: null, rbits: ["rlandbit", "rlightbit"]},
    {rid: "MAINT", desc2: "Maintenance Room", desc1: "This is what appears to have been the maintenance room for Flood\nControl Dam #3, judging by the assortment of tool chests around the\nroom.  Apparently, this room has been ransacked recently, for most of\nthe valuable equipment is gone. On the wall in front of you is a\ngroup of buttons, which are labelled in EBCDIC. However, they are of\ndifferent colors:  Blue, Yellow, Brown, and Red. The doors to this\nroom are in the west and south ends.", exits: [{dir: "South", to: {kind: "room", to: "LOBBY"}}, {dir: "West", to: {kind: "room", to: "LOBBY"}}], contents: ["LEAK", "TUBE", "WRENC", "BLBUT", "RBUTT", "BRBUT", "YBUTT", "SCREW", "TCHST"], roomf: "maint_room", rbits: ["rlandbit"]},
    {rid: "DOCK", desc2: "Dam Base", desc1: "You are at the base of Flood Control Dam #3, which looms above you\nand to the north.  The river Frigid is flowing by here.  Across the\nriver are the White Cliffs which seem to form a giant wall stretching\nfrom north to south along the east shore of the river as it winds its\nway downstream.", exits: [{dir: "North", to: {kind: "room", to: "DAM"}}, {dir: "Up", to: {kind: "room", to: "DAM"}}, {dir: "Launc", to: {kind: "room", to: "RIVR1"}}], contents: ["IBOAT", "STICK"], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RIVR1", desc2: "Frigid River", desc1: "You are on the River Frigid in the vicinity of the Dam.  The river\nflows quietly here.  There is a landing on the west shore.", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot go upstream due to strong currents."}}, {dir: "West", to: {kind: "room", to: "DOCK"}}, {dir: "Land", to: {kind: "room", to: "DOCK"}}, {dir: "Down", to: {kind: "room", to: "RIVR2"}}, {dir: "East", to: {kind: "nexit", msg: "The White Cliffs prevent your landing here."}}], contents: [], roomf: null, rbits: ["rwaterbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RIVR2", desc2: "Frigid River", desc1: "The River turns a corner here making it impossible to see the\nDam.  The White Cliffs loom on the east bank and large rocks prevent\nlanding on the west.", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot go upstream due to strong currents."}}, {dir: "Down", to: {kind: "room", to: "RIVR3"}}, {dir: "East", to: {kind: "nexit", msg: "The White Cliffs prevent your landing here."}}], contents: [], roomf: null, rbits: ["rwaterbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RIVR3", desc2: "Frigid River", desc1: "The river descends here into a valley.  There is a narrow beach on\nthe east below the cliffs and there is some shore on the west which\nmay be suitable.  In the distance a faint rumbling can be heard.", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot go upstream due to strong currents."}}, {dir: "Down", to: {kind: "room", to: "RIVR4"}}, {dir: "East", to: {kind: "room", to: "WCLF1"}}, {dir: "West", to: {kind: "room", to: "RCAVE"}}, {dir: "Land", to: {kind: "nexit", msg: "You must specify which direction here."}}], contents: [], roomf: null, rbits: ["rwaterbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "WCLF1", desc2: "White Cliffs Beach", desc1: "You are on a narrow strip of beach which runs along the base of the\nWhite Cliffs. The only path here is a narrow one, heading south\nalong the Cliffs.", exits: [{dir: "South", to: {kind: "cexit", flag: "deflate", to: "WCLF2", msg: "The path is too narrow.", fn: null}}, {dir: "Launc", to: {kind: "room", to: "RIVR3"}}], contents: ["WCLIF"], roomf: "cliff_function", rbits: ["rlandbit", "rsacredbit", "rnwallbit"], rglobal: ["rgwater"]},
    {rid: "WCLF2", desc2: "White Cliffs Beach", desc1: "You are on a rocky, narrow strip of beach beside the Cliffs.  A\nnarrow path leads north along the shore.", exits: [{dir: "North", to: {kind: "cexit", flag: "deflate", to: "WCLF1", msg: "The path is too narrow.", fn: null}}, {dir: "Launc", to: {kind: "room", to: "RIVR4"}}], contents: ["WCLIF"], roomf: "cliff_function", rbits: ["rnwallbit", "rlandbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RIVR4", desc2: "Frigid River", desc1: "The river is running faster here and the sound ahead appears to be\nthat of rushing water.  On the west shore is a sandy beach.  A small\narea of beach can also be seen below the Cliffs.", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot go upstream due to strong currents."}}, {dir: "Down", to: {kind: "room", to: "RIVR5"}}, {dir: "East", to: {kind: "room", to: "WCLF2"}}, {dir: "West", to: {kind: "room", to: "BEACH"}}, {dir: "Land", to: {kind: "nexit", msg: "Specify the direction to land."}}], contents: ["BUOY"], roomf: "rivr4_room", rbits: ["rwaterbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RIVR5", desc2: "Frigid River", desc1: "The sound of rushing water is nearly unbearable here.  On the west\nshore is a large landing area.", exits: [{dir: "Up", to: {kind: "nexit", msg: "You cannot go upstream due to strong currents."}}, {dir: "Down", to: {kind: "room", to: "FCHMP"}}, {dir: "Land", to: {kind: "room", to: "FANTE"}}], contents: [], roomf: null, rbits: ["rwaterbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "FCHMP", desc2: "Moby lossage", desc1: "", exits: [{dir: "North", to: {kind: "nexit", msg: ""}}], contents: [], roomf: "over_falls", rbits: ["rlandbit"]},
    {rid: "FANTE", desc2: "Shore", desc1: "You are on the shore of the River.  The river here seems somewhat\ntreacherous.  A path travels from north to south here, the south end\nquickly turning around a sharp corner.", exits: [{dir: "Launc", to: {kind: "room", to: "RIVR5"}}, {dir: "North", to: {kind: "room", to: "BEACH"}}, {dir: "South", to: {kind: "room", to: "FALLS"}}], contents: [], roomf: null, rbits: ["rnwallbit", "rlandbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "BEACH", desc2: "Sandy Beach", desc1: "You are on a large sandy beach at the shore of the river, which is\nflowing quickly by.  A path runs beside the river to the south here.", exits: [{dir: "Launc", to: {kind: "room", to: "RIVR4"}}, {dir: "South", to: {kind: "room", to: "FANTE"}}], contents: ["STATU", "SAND"], roomf: null, rbits: ["rnwallbit", "rlandbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RCAVE", desc2: "Rocky Shore", desc1: "You are on the west shore of the river.  An entrance to a cave is\nto the northwest.  The shore is very rocky here.", exits: [{dir: "Launc", to: {kind: "room", to: "RIVR3"}}, {dir: "Nw", to: {kind: "room", to: "TCAVE"}}], contents: [], roomf: null, rbits: ["rnwallbit", "rlandbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "TCAVE", desc2: "Small Cave", desc1: "This is a small cave whose exits are on the south and northwest.", exits: [{dir: "South", to: {kind: "room", to: "RCAVE"}}, {dir: "Nw", to: {kind: "room", to: "CHAS3"}}], contents: ["GUANO", "SHOVE"], roomf: null, rbits: ["rlandbit"]},
    {rid: "FALLS", desc2: "Aragain Falls", desc1: "", exits: [{dir: "East", to: {kind: "cexit", flag: "rainbow", to: "RAINB", msg: "", fn: null}}, {dir: "Down", to: {kind: "nexit", msg: "It's a long way..."}}, {dir: "North", to: {kind: "room", to: "FANTE"}}, {dir: "Up", to: {kind: "cexit", flag: "rainbow", to: "RAINB", msg: "", fn: null}}], contents: ["RAINB", "BARRE"], roomf: "falls_room", rbits: ["rnwallbit", "rlandbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "RAINB", desc2: "Rainbow Room", desc1: "You are on top of a rainbow (I bet you never thought you would walk\non a rainbow), with a magnificent view of the Falls.  The rainbow\ntravels east-west here.  There is an NBC Commissary here.", exits: [{dir: "East", to: {kind: "room", to: "POG"}}, {dir: "West", to: {kind: "room", to: "FALLS"}}], contents: [], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit", "rsacredbit"]},
    {rid: "POG", desc2: "End of Rainbow", desc1: "You are on a small, rocky beach on the continuation of the Frigid\nRiver past the Falls.  The beach is narrow due to the presence of the\nWhite Cliffs.  The river canyon opens here and sunlight shines in\nfrom above. A rainbow crosses over the falls to the west and a narrow\npath continues to the southeast.", exits: [{dir: "Up", to: {kind: "cexit", flag: "rainbow", to: "RAINB", msg: "", fn: null}}, {dir: "Nw", to: {kind: "cexit", flag: "rainbow", to: "RAINB", msg: "", fn: null}}, {dir: "West", to: {kind: "cexit", flag: "rainbow", to: "RAINB", msg: "", fn: null}}, {dir: "Se", to: {kind: "room", to: "CLBOT"}}, {dir: "Launc", to: {kind: "nexit", msg: "The sharp rocks endanger your boat."}}], contents: ["RAINB", "POT"], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit"], rglobal: ["rgwater"]},
    {rid: "CLBOT", desc2: "Canyon Bottom", desc1: "You are beneath the walls of the river canyon which may be climbable\nhere.  There is a small stream here, which is the lesser part of the\nrunoff of Aragain Falls. To the north is a narrow path.", exits: [{dir: "Up", to: {kind: "room", to: "CLMID"}}, {dir: "North", to: {kind: "room", to: "POG"}}], contents: ["CCLIF"], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit", "rsacredbit"], rglobal: ["rgwater"]},
    {rid: "CLMID", desc2: "Rocky Ledge", desc1: "You are on a ledge about halfway up the wall of the river canyon.\nYou can see from here that the main flow from Aragain Falls twists\nalong a passage which it is impossible to enter.  Below you is the\ncanyon bottom.  Above you is more cliff, which still appears\nclimbable.", exits: [{dir: "Up", to: {kind: "room", to: "CLTOP"}}, {dir: "Down", to: {kind: "room", to: "CLBOT"}}], contents: ["CCLIF"], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit", "rsacredbit"]},
    {rid: "CLTOP", desc2: "Canyon View", desc1: "You are at the top of the Great Canyon on its south wall.  From here\nthere is a marvelous view of the Canyon and parts of the Frigid River\nupstream.  Across the canyon, the walls of the White Cliffs still\nappear to loom far above.  Following the Canyon upstream (north and\nnorthwest), Aragain Falls may be seen, complete with rainbow. \nFortunately, my vision is better than average and I can discern the\ntop of the Flood Control Dam #3 far to the distant north.  To the\nwest and south can be seen an immense forest, stretching for miles\naround.  It is possible to climb down into the canyon from here.", exits: [{dir: "Down", to: {kind: "room", to: "CLMID"}}, {dir: "South", to: {kind: "room", to: "FORE4"}}, {dir: "West", to: {kind: "room", to: "FORE5"}}], contents: ["CCLIF"], roomf: null, rbits: ["rlandbit", "rlightbit", "rnwallbit", "rsacredbit"]},
    {rid: "VLBOT", desc2: "Volcano Bottom", desc1: "You are at the bottom of a large dormant volcano.  High above you\nlight may be seen entering from the cone of the volcano.  The only\nexit here is to the north.", exits: [{dir: "North", to: {kind: "room", to: "LAVA"}}], contents: ["BALLO"], roomf: null, rbits: ["rlandbit"]},
    {rid: "VAIR1", desc2: "Volcano Core", desc1: "You are about one hundred feet above the bottom of the volcano.  The\ntop of the volcano is clearly visible here.", exits: [], contents: [], roomf: null, rbits: ["rairbit", "rnwallbit", "rsacredbit"]},
    {rid: "VAIR2", desc2: "Volcano near small ledge", desc1: "You are about two hundred feet above the volcano floor.  Looming\nabove is the rim of the volcano.  There is a small ledge on the west\nside.", exits: [{dir: "West", to: {kind: "room", to: "LEDG2"}}, {dir: "Land", to: {kind: "room", to: "LEDG2"}}], contents: [], roomf: null, rbits: ["rairbit", "rnwallbit", "rsacredbit"]},
    {rid: "VAIR3", desc2: "Volcano near viewing ledge", desc1: "You are high above the floor of the volcano.  From here the rim of\nthe volcano looks very narrow and you are very near it.  To the \neast is what appears to be a viewing ledge, too thin to land on.", exits: [], contents: [], roomf: null, rbits: ["rairbit", "rnwallbit", "rsacredbit"]},
    {rid: "VAIR4", desc2: "Volcano near wide ledge", desc1: "You are near the rim of the volcano which is only about 15 feet\nacross.  To the west, there is a place to land on a wide ledge.", exits: [{dir: "Land", to: {kind: "room", to: "LEDG4"}}, {dir: "East", to: {kind: "room", to: "LEDG4"}}], contents: [], roomf: null, rbits: ["rairbit", "rnwallbit", "rsacredbit"]},
    {rid: "LEDG2", desc2: "Narrow Ledge", desc1: "You are on a narrow ledge overlooking the inside of an old dormant\nvolcano.  This ledge appears to be about in the middle between the\nfloor below and the rim above. There is an exit here to the south.", exits: [{dir: "Down", to: {kind: "nexit", msg: "I wouldn't jump from here."}}, {dir: "Launc", to: {kind: "room", to: "VAIR2"}}, {dir: "West", to: {kind: "cexit", flag: "gnome_door", to: "VLBOT", msg: "", fn: null}}, {dir: "South", to: {kind: "room", to: "LIBRA"}}], contents: ["HOOK1", "COIN"], roomf: null, rbits: ["rlandbit"]},
    {rid: "LIBRA", desc2: "Library", desc1: "This is a room which must have been a large library, probably\nfor the royal family.  All of the shelves appear to have been gnawed\nto pieces by unfriendly gnomes.  To the north is an exit.", exits: [{dir: "North", to: {kind: "room", to: "LEDG2"}}, {dir: "Out", to: {kind: "room", to: "LEDG2"}}], contents: ["BLBK", "GRBK", "PUBK", "WHBK"], roomf: null, rbits: ["rlandbit"]},
    {rid: "LEDG3", desc2: "Volcano View", desc1: "You are on a ledge in the middle of a large volcano.  Below you\nthe volcano bottom can be seen and above is the rim of the volcano.\nA couple of ledges can be seen on the other side of the volcano;\nit appears that this ledge is intermediate in elevation between\nthose on the other side.  The exit from this room is to the east.", exits: [{dir: "Down", to: {kind: "nexit", msg: "I wouldn't try that."}}, {dir: "Cross", to: {kind: "nexit", msg: "It is impossible to cross this distance."}}, {dir: "East", to: {kind: "room", to: "EGYPT"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "LEDG4", desc2: "Wide Ledge", desc1: "", exits: [{dir: "Down", to: {kind: "nexit", msg: "It's a long way down."}}, {dir: "Launc", to: {kind: "room", to: "VAIR4"}}, {dir: "West", to: {kind: "cexit", flag: "gnome_door", to: "VLBOT", msg: "", fn: null}}, {dir: "South", to: {kind: "room", to: "SAFE"}}], contents: ["HOOK2"], roomf: "ledge_function", rbits: ["rlandbit"]},
    {rid: "SAFE", desc2: "Dusty Room", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "LEDG4"}}], contents: ["SSLOT", "SAFE"], roomf: "safe_room", rbits: ["rlandbit", "rlightbit"]},
    {rid: "LAVA", desc2: "Lava Room", desc1: "This is a small room, whose walls are formed by an old lava flow.\nThere are exits here to the west and the south.", exits: [{dir: "South", to: {kind: "room", to: "VLBOT"}}, {dir: "West", to: {kind: "room", to: "RUBYR"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "MAGNE", desc2: "Low Room", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "West", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "East", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}, {dir: "Out", to: {kind: "cexit", flag: "frobozz()", to: "CMACH", msg: "", fn: "magnet_room_exit"}}], contents: ["RBTLB", "ROBOT"], roomf: "magnet_room", rbits: ["rlandbit"]},
    {rid: "CMACH", desc2: "Machine Room", desc1: "", exits: [{dir: "West", to: {kind: "room", to: "MAGNE"}}, {dir: "South", to: {kind: "room", to: "CAGER"}}], contents: ["SQBUT", "RNBUT", "TRBUT"], roomf: "cmach_room", rbits: ["rlandbit"]},
    {rid: "CAGER", desc2: "Dingy Closet", desc1: "This is a dingy closet adjacent to the machine room.  On one wall\nis a small sticker which says\n\t\tProtected by\n\t\t  FROBOZZ\n\t     Magic Alarm Company\n\t      (Hello, footpad!)\n", exits: [{dir: "North", to: {kind: "room", to: "CMACH"}}], contents: ["SPHER"], roomf: null, rbits: ["rlightbit", "rlandbit"]},
    {rid: "CAGED", desc2: "Cage", desc1: "You are trapped inside a steel cage.", exits: [{dir: "North", to: {kind: "nexit", msg: ""}}], contents: ["CAGE"], roomf: "caged_room", rbits: ["rlandbit", "rnwallbit"]},
    {rid: "TWELL", desc2: "Top of Well", desc1: "You are at the top of the well.  Well done.  There are etchings on\nthe side of the well. There is a small crack across the floor at the\nentrance to a room on the east, but it can be crossed easily.", exits: [{dir: "East", to: {kind: "room", to: "ALICE"}}, {dir: "Down", to: {kind: "nexit", msg: "It's a long way down!"}}], contents: ["ETCH2"], roomf: null, rbits: ["rlandbit", "rbuckbit"], rval: 10, rglobal: ["wellbit"]},
    {rid: "BWELL", desc2: "Circular Room", desc1: "This is a damp circular room, whose walls are made of brick and\nmortar.  The roof of this room is not visible, but there appear to be\nsome etchings on the walls.  There is a passageway to the west.", exits: [{dir: "West", to: {kind: "room", to: "MPEAR"}}, {dir: "Up", to: {kind: "nexit", msg: "The walls cannot be climbed."}}], contents: ["BUCKE", "ETCH1"], roomf: null, rbits: ["rlandbit", "rbuckbit"], rglobal: ["wellbit"]},
    {rid: "ALICE", desc2: "Tea Room", desc1: "This is a small square room, in the center of which is a large\noblong table, no doubt set for afternoon tea.  It is clear from the\nobjects on the table that the users were indeed mad.  In the eastern\ncorner of the room is a small hole (no more than four inches high). \nThere are passageways leading away to the west and the northwest.", exits: [{dir: "East", to: {kind: "nexit", msg: "Only a mouse could get in there."}}, {dir: "West", to: {kind: "room", to: "TWELL"}}, {dir: "Nw", to: {kind: "room", to: "MAGNE"}}], contents: ["ATABL", "ECAKE", "ORICE", "RDICE", "BLICE"], roomf: null, rbits: ["rlandbit"]},
    {rid: "ALISM", desc2: "Posts Room", desc1: "This is an enormous room, in the center of which are four wooden\nposts delineating a rectangular area, above which is what appears to\nbe a wooden roof.  In fact, all objects in this room appear to be\nabnormally large. To the east is a passageway.  There is a large\nchasm on the west and the northwest.", exits: [{dir: "Nw", to: {kind: "nexit", msg: "There is a chasm too large to jump across."}}, {dir: "East", to: {kind: "room", to: "ALITR"}}, {dir: "West", to: {kind: "nexit", msg: "There is a chasm too large to jump across."}}, {dir: "Down", to: {kind: "nexit", msg: "There is a chasm too large to jump across."}}], contents: ["POSTS"], roomf: null, rbits: ["rlandbit"]},
    {rid: "ALITR", desc2: "Pool Room", desc1: "This is a large room, one half of which is depressed.  There is a\nlarge leak in the ceiling through which brown colored goop is\nfalling.  The only exit to this room is to the west.", exits: [{dir: "Exit", to: {kind: "room", to: "ALISM"}}, {dir: "West", to: {kind: "room", to: "ALISM"}}], contents: ["FLASK", "POOL", "PLEAK", "SAFFR"], roomf: null, rbits: ["rlandbit"]},
    {rid: "BKENT", desc2: "Bank Entrance", desc1: "This is the large entrance hall of the Bank of Zork, the largest\nbanking institution of the Great Underground Empire. A partial\naccount of its history is in 'The Lives of the Twelve Flatheads' with\nthe chapter on J. Pierpont Flathead.  A more detailed history (albeit\nless objective) may be found in Flathead's outrageous autobiography\n'I'm Rich and You Aren't - So There!'.\nMost of the furniture has been ravaged by passing scavengers.  All\nthat remains are two signs at the Northwest and Northeast corners of\nthe room, which say\n  \n      <--  WEST VIEWING ROOM        EAST VIEWING ROOM  -->  \n", exits: [{dir: "Nw", to: {kind: "room", to: "BKTW"}}, {dir: "Ne", to: {kind: "room", to: "BKTE"}}, {dir: "South", to: {kind: "room", to: "GALLE"}}], contents: [], roomf: null, rbits: ["rlandbit"]},
    {rid: "BKTW", desc2: "West Teller's Room", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "BKVW"}}, {dir: "South", to: {kind: "room", to: "BKENT"}}, {dir: "West", to: {kind: "room", to: "BKBOX"}}], contents: [], roomf: "teller_room", rbits: ["rlandbit"]},
    {rid: "BKTE", desc2: "East Teller's Room", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "BKVE"}}, {dir: "South", to: {kind: "room", to: "BKENT"}}, {dir: "East", to: {kind: "room", to: "BKBOX"}}], contents: [], roomf: "teller_room", rbits: ["rlandbit"]},
    {rid: "BKVW", desc2: "Viewing Room", desc1: "This is a room used by holders of safety deposit boxes to view\ntheir contents.  On the north side of the room is a sign which says \n\t\n   REMAIN HERE WHILE THE BANK OFFICER RETRIEVES YOUR DEPOSIT BOX\n    WHEN YOU ARE FINISHED, LEAVE THE BOX, AND EXIT TO THE SOUTH  \n     AN ADVANCED PROTECTIVE DEVICE PREVENTS ALL CUSTOMERS FROM\n      REMOVING ANY SAFETY DEPOSIT BOX FROM THIS VIEWING AREA!\n               Thank You for banking at the Zork!\n", exits: [{dir: "South", to: {kind: "room", to: "BKENT"}}], contents: [], roomf: null, rbits: ["rlandbit"], rglobal: ["wall_eswbit", "wall_nbit"]},
    {rid: "BKVE", desc2: "Viewing Room", desc1: "This is a room used by holders of safety deposit boxes to view\ntheir contents.  On the north side of the room is a sign which says \n\t\n   REMAIN HERE WHILE THE BANK OFFICER RETRIEVES YOUR DEPOSIT BOX\n    WHEN YOU ARE FINISHED, LEAVE THE BOX, AND EXIT TO THE SOUTH  \n     AN ADVANCED PROTECTIVE DEVICE PREVENTS ALL CUSTOMERS FROM\n      REMOVING ANY SAFETY DEPOSIT BOX FROM THIS VIEWING AREA!\n               Thank You for banking at the Zork!\n", exits: [{dir: "South", to: {kind: "room", to: "BKENT"}}], contents: [], roomf: null, rbits: ["rlandbit"], rglobal: ["wall_eswbit", "wall_nbit"]},
    {rid: "BKTWI", desc2: "Small Room", desc1: "This is a small, bare room with no distinguishing features. There\nare no exits from this room.", exits: [], contents: [], roomf: null, rbits: ["rlandbit", "rsacredbit"], rglobal: ["wall_eswbit", "wall_nbit"]},
    {rid: "BKVAU", desc2: "Vault", desc1: "This is the Vault of the Bank of Zork, in which there are no doors.", exits: [], contents: ["BILLS"], roomf: null, rbits: ["rsacredbit", "rlandbit"], rglobal: ["wall_eswbit", "wall_nbit"]},
    {rid: "BKBOX", desc2: "Safety Depository", desc1: "This is a large rectangular room.  The east and west walls here\nwere used for storing safety deposit boxes.  As might be expected,\nall have been carefully removed by evil persons.  To the east, west,\nand south of the room are large doorways. The northern 'wall'\nof the room is a shimmering curtain of light.  In the center of the\nroom is a large stone cube, about 10 feet on a side.  Engraved on \nthe side of the cube is some lettering.", exits: [{dir: "North", to: {kind: "nexit", msg: "There is a curtain of light there."}}, {dir: "West", to: {kind: "cexit", flag: "frobozz()", to: "BKTW", msg: "An alarm rings briefly and an invisible force prevents your leaving.", fn: "bkleavew"}}, {dir: "East", to: {kind: "cexit", flag: "frobozz()", to: "BKTE", msg: "An alarm rings briefly and an invisible force prevents your leaving.", fn: "bkleavee"}}, {dir: "South", to: {kind: "room", to: "BKEXE"}}], contents: ["VAULT", "SCOL"], roomf: "bkbox_room", rbits: ["rlandbit", "rlightbit"], rglobal: ["wall_nbit"]},
    {rid: "BKEXE", desc2: "Chairman's Office", desc1: "This room was the office of the Chairman of the Bank of Zork.\nLike the other rooms here, it has been extensively vandalized.\nThe lone exit is to the north.", exits: [{dir: "North", to: {kind: "room", to: "BKBOX"}}], contents: ["PORTR"], roomf: null, rbits: ["rlandbit"]},
    {rid: "CPANT", desc2: "Small Square Room", desc1: "This is a small square room, in the middle of which is a recently \ncreated hole through which you can barely discern the floor some ten\nfeet below.  It doesn't seem likely you could climb back up.  There\nare exits to the west and south.", exits: [{dir: "South", to: {kind: "room", to: "CPOUT"}}, {dir: "West", to: {kind: "room", to: "TREAS"}}, {dir: "Down", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpenter"}}], contents: ["WARNI"], roomf: null, rbits: ["rlandbit", "rlightbit"]},
    {rid: "CPOUT", desc2: "Side Room", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "CPANT"}}, {dir: "East", to: {kind: "cexit", flag: "cpout", to: "CP", msg: "The steel door bars the way.", fn: null}}], contents: ["CPDR2"], roomf: "cpout_room", rbits: ["rlandbit"]},
    {rid: "CP", desc2: "Room in a Puzzle", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "East", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "West", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "Up", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "FCHMP", msg: "", fn: "cpexit"}}], contents: [], roomf: "cp_room", rbits: ["rlandbit", "rlightbit"], rglobal: ["cpladder", "cpwall"]},
    {rid: "PALAN", desc2: "Dreary Room", desc1: "", exits: [{dir: "South", to: {kind: "door", obj: "PDOOR", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}, {dir: "Exit", to: {kind: "door", obj: "PDOOR", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}, {dir: "NullExit", to: {kind: "door", obj: "PWIND", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}], contents: ["PDOOR", "PWIND", "PLID2", "PKH2", "PALAN", "PTABL", "PCRAK"], roomf: "palantir_room", rbits: ["rlandbit", "rlightbit", "rsacredbit"]},
    {rid: "PRM", desc2: "Tiny Room", desc1: "", exits: [{dir: "North", to: {kind: "door", obj: "PDOOR", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}, {dir: "Enter", to: {kind: "door", obj: "PDOOR", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}, {dir: "NullExit", to: {kind: "door", obj: "PWIND", rm1: "PALAN", rm2: "PRM", msg: "", fn: null}}, {dir: "East", to: {kind: "room", to: "MTORC"}}], contents: ["PDOOR", "PWIND", "PLID1", "PKH1"], roomf: "prm_room", rbits: ["rlandbit"]},
    {rid: "SLIDE", desc2: "Slide Room", desc1: "", exits: [{dir: "East", to: {kind: "room", to: "PASS3"}}, {dir: "North", to: {kind: "room", to: "ENTRA"}}, {dir: "Down", to: {kind: "cexit", flag: "frobozz()", to: "CAVE4", msg: "", fn: "slide_exit"}}], contents: [], roomf: "slide_room", rbits: ["rlandbit"], rglobal: ["slidebit"]},
    {rid: "SLID1", desc2: "Slide", desc1: "This is an uncomfortable spot within the coal chute.  The rope to\nwhich you are clinging can be seen rising into the darkness above.\nThere is more rope dangling below you.", exits: [{dir: "Down", to: {kind: "room", to: "SLID2"}}, {dir: "Up", to: {kind: "room", to: "SLIDE"}}], contents: [], roomf: "inslide", rbits: ["rlandbit", "rsacredbit"], rglobal: ["ropebit", "slidebit"]},
    {rid: "SLID2", desc2: "Slide", desc1: "This is another spot within the coal chute.  Above you the rope\nclimbs into darkness and the end of the rope is dangling five feet\nbeneath you.", exits: [{dir: "Down", to: {kind: "room", to: "SLID3"}}, {dir: "Up", to: {kind: "room", to: "SLID1"}}], contents: [], roomf: "inslide", rbits: ["rlandbit", "rsacredbit"], rglobal: ["ropebit", "slidebit"]},
    {rid: "SLID3", desc2: "Slide", desc1: "You have reached the end of your rope.  Below you is darkness as\nthe chute makes a sharp turn.  On the east here is a small ledge\nwhich you might be able to stand on.", exits: [{dir: "Down", to: {kind: "room", to: "CELLA"}}, {dir: "Up", to: {kind: "room", to: "SLID2"}}, {dir: "East", to: {kind: "room", to: "SLEDG"}}], contents: [], roomf: "inslide", rbits: ["rlandbit", "rsacredbit"], rglobal: ["ropebit", "slidebit"]},
    {rid: "SLEDG", desc2: "Slide Ledge", desc1: "This is a narrow ledge abutting the coal chute, in which a rope can\nbe seen passing downward.  Behind you, to the south, is a small room.", exits: [{dir: "Down", to: {kind: "room", to: "CELLA"}}, {dir: "Up", to: {kind: "room", to: "SLID2"}}, {dir: "South", to: {kind: "room", to: "SPAL"}}], contents: [], roomf: "sledg_room", rbits: ["rlandbit", "rsacredbit"], rglobal: ["ropebit", "slidebit"]},
    {rid: "SPAL", desc2: "Sooty Room", desc1: "This is a small room with rough walls, and a ceiling which is steeply\nsloping from north to south. There is coal dust covering almost\neverything, and little bits of coal are scattered around the only exit\n(which is a narrow passage to the north). In one corner of the room is\nan old coal stove which lights the room with a cheery red glow.  There\nis a very narrow crack in the north wall.", exits: [{dir: "North", to: {kind: "room", to: "SLEDG"}}], contents: ["PAL3", "STOVE"], roomf: null, rbits: ["rlandbit", "rsacredbit", "rlightbit"]},
    {rid: "MRD", desc2: "Hallway", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "FDOOR"}}, {dir: "Ne", to: {kind: "room", to: "FDOOR"}}, {dir: "Nw", to: {kind: "room", to: "FDOOR"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}], contents: [], roomf: "mrdf", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["rosebit", "chanbit", "guardbit"]},
    {rid: "MRG", desc2: "Hallway", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRD", msg: "", fn: "mrgo"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRC", msg: "", fn: "mrgo"}}], contents: [], roomf: "guardians", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["guardbit"]},
    {rid: "MRC", desc2: "Hallway", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "MRG", msg: "", fn: "mrgo"}}, {dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}], contents: [], roomf: "mrcf", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit", "rosebit", "chanbit", "guardbit"]},
    {rid: "MRB", desc2: "Hallway", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRC", msg: "", fn: "mrgo"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "MRC", msg: "", fn: "mrgo"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "MRC", msg: "", fn: "mrgo"}}, {dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}], contents: [], roomf: "mrbf", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit", "rosebit", "chanbit"]},
    {rid: "MRA", desc2: "Hallway", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "MRB", msg: "", fn: "mrgo"}}, {dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "South", to: {kind: "room", to: "MREYE"}}], contents: [], roomf: "mraf", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit", "rosebit", "chanbit"]},
