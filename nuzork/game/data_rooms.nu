    {rid: "MRCE", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "West", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRG"}}, {dir: "South", to: {kind: "room", to: "MRB"}}], contents: [], roomf: "mrcew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit", "guardbit"]},
    {rid: "MRCW", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "East", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRG"}}, {dir: "South", to: {kind: "room", to: "MRB"}}], contents: [], roomf: "mrcew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit", "guardbit"]},
    {rid: "MRBE", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "West", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRC"}}, {dir: "South", to: {kind: "room", to: "MRA"}}], contents: [], roomf: "mrbew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit"]},
    {rid: "MRBW", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "East", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRC"}}, {dir: "South", to: {kind: "room", to: "MRA"}}], contents: [], roomf: "mrbew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit"]},
    {rid: "MRAE", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "West", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRB"}}, {dir: "South", to: {kind: "room", to: "MREYE"}}], contents: [], roomf: "mraew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit"]},
    {rid: "MRAW", desc2: "Narrow Room", desc1: "", exits: [{dir: "Enter", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "East", to: {kind: "cexit", flag: "mirror_open", to: "INMIR", msg: "", fn: "mirin"}}, {dir: "North", to: {kind: "room", to: "MRB"}}, {dir: "South", to: {kind: "room", to: "MREYE"}}], contents: [], roomf: "mraew", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["mirrorbit", "panelbit"]},
    {rid: "INMIR", desc2: "Inside Mirror", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "East", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "West", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}, {dir: "Exit", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mirout"}}], contents: ["YLWAL", "WHWAL", "RDWAL", "BLWAL", "OAKND", "PINND", "WDBAR", "LPOLE", "SPOLE", "TBAR", "ARROW"], roomf: "magic_mirror", rbits: ["rendgame", "rlandbit", "rlightbit"], rval: 15, rglobal: ["rosebit", "chanbit", "guardbit"]},
    {rid: "MRANT", desc2: "Stone Room", desc1: "You are standing near one end of a long, dimly lit hall.  At the\nsouth stone stairs ascend.  To the north the corridor is illuminated\nby torches set high in the walls, out of reach.  On one wall is a red\nbutton.", exits: [{dir: "South", to: {kind: "room", to: "TSTRS"}}, {dir: "Up", to: {kind: "room", to: "TSTRS"}}, {dir: "North", to: {kind: "room", to: "MREYE"}}], contents: ["RSWIT"], roomf: null, rbits: ["rendgame", "rlandbit", "rlightbit"]},
    {rid: "MREYE", desc2: "Small Room", desc1: "", exits: [{dir: "North", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}, {dir: "Nw", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}, {dir: "Ne", to: {kind: "cexit", flag: "frobozz()", to: "MRA", msg: "", fn: "mrgo"}}, {dir: "South", to: {kind: "room", to: "MRANT"}}], contents: ["RBEAM"], roomf: "mreye_room", rbits: ["rendgame", "rlandbit", "rlightbit"]},
    {rid: "TOMB", desc2: "Tomb of the Unknown Implementer", desc1: "", exits: [{dir: "West", to: {kind: "room", to: "LLD2"}}, {dir: "North", to: {kind: "door", obj: "TOMB", rm1: "TOMB", rm2: "CRYPT", msg: "", fn: null}}, {dir: "Enter", to: {kind: "door", obj: "TOMB", rm1: "TOMB", rm2: "CRYPT", msg: "", fn: null}}], contents: ["TOMB", "HEADS", "COKES", "LISTS"], roomf: "tomb_function", rbits: ["rlandbit"]},
    {rid: "CRYPT", desc2: "Crypt", desc1: "", exits: [{dir: "South", to: {kind: "door", obj: "TOMB", rm1: "TOMB", rm2: "CRYPT", msg: "", fn: null}}, {dir: "Leave", to: {kind: "door", obj: "TOMB", rm1: "TOMB", rm2: "CRYPT", msg: "", fn: null}}], contents: ["TOMB"], roomf: "crypt_function", rbits: ["rendgame", "rlandbit"], rval: 5},
    {rid: "TSTRS", desc2: "Top of Stairs", desc1: "You are standing at the top of a flight of stairs that lead down to\na passage below.  Dim light, as from torches, can be seen in the\npassage.  Behind you the stairs lead into untouched rock.", exits: [{dir: "North", to: {kind: "room", to: "MRANT"}}, {dir: "Down", to: {kind: "room", to: "MRANT"}}, {dir: "South", to: {kind: "nexit", msg: "The wall is solid rock."}}], contents: [], roomf: null, rbits: ["rendgame", "rlandbit", "rlightbit"], rval: 10},
    {rid: "ECORR", desc2: "East Corridor", desc1: "This is a corridor with polished marble walls.  The corridor\nwidens into larger areas as it turns west at its northern and\nsouthern ends.", exits: [{dir: "North", to: {kind: "room", to: "NCORR"}}, {dir: "South", to: {kind: "room", to: "SCORR"}}], contents: [], roomf: null, rbits: ["rendgame", "rlandbit", "rlightbit"]},
    {rid: "WCORR", desc2: "West Corridor", desc1: "This is a corridor with polished marble walls.  The corridor\nwidens into larger areas as it turns east at its northern and\nsouthern ends.", exits: [{dir: "North", to: {kind: "room", to: "NCORR"}}, {dir: "South", to: {kind: "room", to: "SCORR"}}], contents: [], roomf: null, rbits: ["rendgame", "rlandbit", "rlightbit"]},
    {rid: "SCORR", desc2: "South Corridor", desc1: "", exits: [{dir: "West", to: {kind: "room", to: "WCORR"}}, {dir: "East", to: {kind: "room", to: "ECORR"}}, {dir: "North", to: {kind: "door", obj: "ODOOR", rm1: "SCORR", rm2: "CELL", msg: "", fn: "maybe_door"}}, {dir: "South", to: {kind: "room", to: "BDOOR"}}], contents: ["ODOOR"], roomf: "scorr_room", rbits: ["rendgame", "rlandbit", "rlightbit"]},
    {rid: "BDOOR", desc2: "Narrow Corridor", desc1: "", exits: [{dir: "North", to: {kind: "room", to: "SCORR"}}, {dir: "South", to: {kind: "door", obj: "QDOOR", rm1: "BDOOR", rm2: "FDOOR", msg: "", fn: null}}], contents: ["MASTE", "QDOOR"], roomf: "bdoor_function", rbits: ["rendgame", "rlandbit", "rlightbit"], rval: 20},
    {rid: "FDOOR", desc2: "Dungeon Entrance", desc1: "", exits: [{dir: "North", to: {kind: "door", obj: "QDOOR", rm1: "BDOOR", rm2: "FDOOR", msg: "", fn: null}}, {dir: "Enter", to: {kind: "door", obj: "QDOOR", rm1: "BDOOR", rm2: "FDOOR", msg: "", fn: null}}, {dir: "South", to: {kind: "cexit", flag: "frobozz()", to: "MRD", msg: "", fn: "mrgo"}}, {dir: "Se", to: {kind: "cexit", flag: "frobozz()", to: "MRD", msg: "", fn: "mrgo"}}, {dir: "Sw", to: {kind: "cexit", flag: "frobozz()", to: "MRD", msg: "", fn: "mrgo"}}], contents: ["QDOOR"], roomf: "fdoor_function", rbits: ["rendgame", "rlandbit", "rlightbit"], rval: 15, rglobal: ["masterbit"]},
    {rid: "NCORR", desc2: "North Corridor", desc1: "", exits: [{dir: "East", to: {kind: "room", to: "ECORR"}}, {dir: "West", to: {kind: "room", to: "WCORR"}}, {dir: "North", to: {kind: "room", to: "PARAP"}}, {dir: "South", to: {kind: "door", obj: "CDOOR", rm1: "NCORR", rm2: "CELL", msg: "", fn: null}}, {dir: "Enter", to: {kind: "door", obj: "CDOOR", rm1: "NCORR", rm2: "CELL", msg: "", fn: null}}], contents: ["CDOOR"], roomf: "ncorr_room", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["masterbit"]},
    {rid: "PARAP", desc2: "Parapet", desc1: "", exits: [{dir: "South", to: {kind: "room", to: "NCORR"}}, {dir: "North", to: {kind: "nexit", msg: "You would be burned to a crisp in no time."}}], contents: ["DBUTT", "DIAL", "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT"], roomf: "parapet", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["masterbit"]},
    {rid: "CELL", desc2: "Prison Cell", desc1: "", exits: [{dir: "Exit", to: {kind: "door", obj: "CDOOR", rm1: "NCORR", rm2: "CELL", msg: "", fn: null}}, {dir: "North", to: {kind: "door", obj: "CDOOR", rm1: "NCORR", rm2: "CELL", msg: "", fn: null}}, {dir: "South", to: {kind: "door", obj: "ODOOR", rm1: "SCORR", rm2: "CELL", msg: "", fn: "maybe_door"}}], contents: ["CDOOR", "ODOOR"], roomf: "cell_room", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["masterbit"]},
    {rid: "PCELL", desc2: "Prison Cell", desc1: "", exits: [{dir: "Exit", to: {kind: "nexit", msg: "The door is securely fastened."}}], contents: ["LDOOR"], roomf: "pcell_room", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["masterbit"]},
    {rid: "NCELL", desc2: "Prison Cell", desc1: "", exits: [{dir: "South", to: {kind: "nexit", msg: "The door is securely fastened."}}, {dir: "Exit", to: {kind: "door", obj: "ODOOR", rm1: "NCELL", rm2: "NIRVA", msg: "", fn: null}}, {dir: "North", to: {kind: "door", obj: "ODOOR", rm1: "NCELL", rm2: "NIRVA", msg: "", fn: null}}], contents: ["ODOOR", "MDOOR"], roomf: "ncell_room", rbits: ["rendgame", "rlandbit", "rlightbit"], rglobal: ["masterbit"]},
    {rid: "NIRVA", desc2: "Treasury of Zork", desc1: "     This is a room of large size, richly appointed and decorated\nin a style that bespeaks exquisite taste.  To judge from its\ncontents, it is the ultimate storehouse of the treasures of Zork.\n     There are chests here containing precious jewels, mountains of\nzorkmids, rare paintings, ancient statuary, and beguiling curios.\n     In one corner of the room is a bookcase boasting such volumes as\n'The History of the Great Underground Empire,' 'The Lives of the\nTwelve Flatheads,' 'The Wisdom of the Implementors,' and other\ninformative and inspiring works.\n     On one wall is a completely annotated map of the Great Underground\nEmpire, showing points of interest, various troves of treasure, and\nindicating the locations of several superior scenic views.\n     On a desk at the far end of the room may be found stock\ncertificates representing a controlling interest in FrobozzCo\nInternational, the multinational conglomerate and parent company of\nthe Frobozz Magic Boat Co., etc.", exits: [], contents: ["ODOOR"], roomf: "nirvana", rbits: ["rendgame", "rlandbit", "rlightbit"], rval: 35},
]
