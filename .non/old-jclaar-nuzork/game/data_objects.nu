    {oid: "LDOOR", syns: ["LDOOR", "DOOR"], adj: ["LOCKE", "WOOD", "WOODE", "CELL"], desc: "locked door", bits: ["ovison", "doorbit", "ndescbit"], objfn: "locked_door", contents: [], is_global: false},
