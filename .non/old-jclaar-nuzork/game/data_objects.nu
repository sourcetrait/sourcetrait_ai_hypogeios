    {oid: "THREE", syns: ["THREE", "3"], adj: [], desc: "number three", bits: ["ovison", "ndescbit"], objfn: null, contents: [], is_global: false},
    {oid: "TWO", syns: ["TWO", "2"], adj: [], desc: "number two", bits: ["ovison", "ndescbit"], objfn: null, contents: [], is_global: false},
    {oid: "PAINT", syns: ["PAINT", "ART", "CANVA", "MASTE", "PICTU", "WORK"], adj: [], desc: "painting", bits: ["ovison", "takebit", "burnbit"], objfn: "painting", contents: [], is_global: false, odesco: "Fortunately, there is still one chance for you to be a vandal, for on\nthe far wall is a work of unparalleled beauty.", odesc1: "A masterpiece by a neglected genius is here.", osize: 15, ofval: 4, otval: 7},
    {oid: "CANDL", syns: ["CANDL", "PAIR"], adj: [], desc: "pair of candles", bits: ["ovison", "takebit", "lightbit", "flamebit", "onbit"], objfn: "candles", contents: [], is_global: false, odesco: "On the two ends of the altar are burning candles.", odesc1: "There are two candles here.", osize: 10, olint: "olint_t(0, cndin,50)"},
