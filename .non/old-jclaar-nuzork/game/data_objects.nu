    {oid: "PLEAK", syns: ["PLEAK", "LEAK"], adj: ["LARGE"], desc: "leak", bits: ["ovison", "ndescbit"], objfn: "pleak", contents: [], is_global: false},
    {oid: "POOL", syns: ["POOL", "SEWAG", "GOOP"], adj: ["LARGE", "BROWN"], desc: "pool of sewage", bits: ["ovison", "vicbit"], objfn: null, contents: [], is_global: false, odesc1: "The leak has submerged the depressed area in a pool of sewage."},
    {oid: "POT", syns: ["POT", "GOLD"], adj: ["GOLD"], desc: "pot of gold", bits: ["takebit"], objfn: null, contents: [], is_global: false, odesco: "At the end of the rainbow is a pot of gold.", odesc1: "There is a pot of gold here.", osize: 15, ofval: 10, otval: 10},
    {oid: "PRAYE", syns: ["PRAYE", "INSCR"], adj: ["ANCIE", "OLD"], desc: "prayer", bits: ["ovison", "readbit", "sacredbit"], objfn: null, contents: [], is_global: false, oread: "The prayer is inscribed in an ancient script which is hardly\nremembered these days, much less understood.  What little of it can\nbe made out seems to be a philippic against small insects,\nabsent-mindedness, and the picking up and dropping of small objects. \nThe final verse seems to consign trespassers to the land of the\ndead.  All evidence indicates that the beliefs of the ancient\nZorkers were obscure."},
    {oid: "COIN", syns: ["COIN", "ZORKM", "GOLD"], adj: ["GOLD", "PRICE"], desc: "priceless zorkmid", bits: ["ovison", "readbit", "takebit"], objfn: null, contents: [], is_global: false, odesco: "On the floor is a gold zorkmid coin (a valuable collector's item).", odesc1: "There is an engraved zorkmid coin here.", osize: 10, ofval: 10, otval: 12, oread: "\n\t       --------------------------\n\t      /      Gold Zorkmid\t \\\n\t     /  T e n   T h o u s a n d   \\\n\t    /        Z O R K M I D S\t   \\\n\t   /\t\t\t\t    \\\n\t  /        ||||||||||||||||||\t     \\\n\t /        !||||\t\t ||||!\t      \\\n\t|\t   |||   ^^  ^^   |||\t       |\n\t|\t   |||\t OO  OO   |||\t       |\n\t| In Frobs  |||\t   <<    |||  We Trust |\n\t|\t     || (______) ||\t       |\n\t|\t      |          |\t       |\n\t|\t      |__________|\t       |\n\t \\\t\t\t\t      /\n\t  \\    -- Lord Dimwit Flathead --    /\n\t   \\    -- Beloved of Zorkers --    /\n\t    \\\t\t\t\t   /\n\t     \\\t     * 722 G.U.E. *       /\n\t      \\\t\t\t\t /\n\t       --------------------------\n"},
    {oid: "PUBK", syns: ["PUBK", "BOOK"], adj: ["PURPL"], desc: "purple book", bits: ["ovison", "readbit", "takebit", "contbit", "burnbit"], objfn: null, contents: ["STAMP"], is_global: false, odesc1: "There is a purple book here.", ocapac: 2, osize: 10, oread: "This book is written in a tongue with which I am unfamiliar."},
