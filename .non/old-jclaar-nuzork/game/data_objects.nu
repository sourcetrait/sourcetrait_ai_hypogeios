    {oid: "HEADS", syns: ["HEADS", "HEAD", "POLE", "POLES", "PDL", "BKD", "TAA", "MARC", "IMPLE", "LOSER"], adj: [], desc: "set of poled heads", bits: ["ovison", "sacredbit", "trytakebit"], objfn: "head_function", contents: [], is_global: false, odesc1: "There are four heads here, mounted securely on poles."},
    {oid: "KEYS", syns: ["KEYS", "SET", "KEY"], adj: [], desc: "set of skeleton keys", bits: ["ovison", "takebit", "toolbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a set of skeleton keys here.", osize: 10},
    {oid: "SPOLE", syns: ["SPOLE", "POLE", "POST", "HANDG", "GRIP"], adj: ["SHORT", "SMALL"], desc: "short pole", bits: ["ovison", "ndescbit"], objfn: "short_pole", contents: [], is_global: false},
    {oid: "SHOVE", syns: ["SHOVE"], adj: ["LARGE"], desc: "shovel", bits: ["ovison", "takebit", "toolbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a large shovel here.", osize: 15},
    {oid: "BONES", syns: ["BONES", "SKELE", "BODY"], adj: [], desc: "skeleton", bits: ["ovison", "trytakebit"], objfn: "skeleton", contents: [], is_global: false, odesc1: "A skeleton, probably the remains of a luckless adventurer, lies here."},
    {oid: "COAL", syns: ["COAL", "PILE", "HEAP"], adj: ["SMALL"], desc: "small pile of coal", bits: ["ovison", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a small heap of coal here.", osize: 20},
    {oid: "LISTS", syns: ["LISTS", "PAPER", "LIST", "PRINT", "LISTI", "STACK", "OUTPU"], adj: ["GIGAN", "LINE-"], desc: "stack of listings", bits: ["ovison", "readbit", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesco: "There is a gigantic pile of line-printer output here.  Although the\npaper once contained useful information, almost nothing can be\ndistinguished now.", odesc1: "There is an enormous stack of line-printer paper here.  It is barely\nreadable.", osize: 70, oread: "<DEFINE FEEL-FREE (LOSER)\n\t\t   <TELL \"FEEL FREE, CHOMPER!\">>\n\t\t\t...\nThe rest is, alas, unintelligible (as were the implementers)."},
    {oid: "STAMP", syns: ["STAMP"], adj: ["FLATH"], desc: "Flathead stamp", bits: ["ovison", "readbit", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a Flathead stamp here.", osize: 1, ofval: 4, otval: 10, oread: "\n---v----v----v----v----v----v----v----v---\n|\t\t\t\t\t |\n|\t   ||||||||||\t     LORD\t |\n>         !||||\t     |\t    DIMWIT\t <\n|\t  ||||    ---|\t   FLATHEAD\t |\n|\t  |||C\t   CC \\  \t\t |\n>\t   ||||\t      _\\\t\t <\n|\t    ||| (____|\t\t\t |\n|\t     ||      |\t\t\t |\n>\t      |______|\t     Our\t <\n|\t\t/   \\\t  Excessive\t |\n|\t       /     \\\t    Leader\t |\n>\t      |\t      |\t\t\t <\n|\t      |       |\t\t\t |\n|\t\t\t\t\t |\n>    G.U.E. POSTAGE\t   3 Zorkmids    <\n|\t\t\t\t\t |\n---^----^----^----^----^----^----^----^---\n"},
    {oid: "STATU", syns: ["STATU", "SCULP", "ROCK"], adj: ["BEAUT"], desc: "statue", bits: ["takebit"], objfn: null, contents: [], is_global: false, odesc1: "There is a beautiful statue here.", osize: 8, ofval: 10, otval: 13},
    {oid: "IRBOX", syns: ["IRBOX", "BOX"], adj: ["STEEL", "DENTE"], desc: "steel box", bits: ["takebit", "contbit"], objfn: null, contents: ["STRAD"], is_global: false, odesc1: "There is a dented steel box here.", ocapac: 20, osize: 40},
    {oid: "RCAGE", syns: ["RCAGE", "CAGE"], adj: ["STEEL"], desc: "steel cage", bits: ["ovison"], objfn: null, contents: [], is_global: false, odesc1: "There is a steel cage in the middle of the room."},
    {oid: "STILL", syns: ["STILL"], adj: ["VICIO"], desc: "stiletto", bits: ["ovison", "weaponbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a vicious-looking stiletto here.", osize: 10},
    {oid: "DIAL", syns: ["DIAL", "SUNDI"], adj: ["SUN"], desc: "sundial", bits: ["ovison", "ndescbit", "turnbit"], objfn: "dial", contents: [], is_global: false},
    {oid: "MSWIT", syns: ["MSWIT", "SWITC"], adj: [], desc: "switch", bits: ["ovison", "ndescbit", "turnbit"], objfn: "mswitch_function", contents: [], is_global: false},
    {oid: "SWORD", syns: ["SWORD", "ORCRI", "GLAMD", "BLADE"], adj: ["ELVIS"], desc: "sword", bits: ["ovison", "takebit", "weaponbit"], objfn: "sword", contents: [], is_global: false, odesco: "On hooks above the mantelpiece hangs an elvish sword of great\nantiquity.", odesc1: "There is an elvish sword here.", osize: 30, ofmsgs: "&sword_melee", otval: 0},
    {oid: "LABEL", syns: ["LABEL", "FINEP", "PRINT"], adj: ["TAN", "FINE"], desc: "tan label", bits: ["ovison", "readbit", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a tan label here.", osize: 2, oread: "\t  !!!! \tFROBOZZ MAGIC BOAT COMPANY  !!!!\n\nHello, Sailor!\n\nInstructions for use:\n   \n   To get into boat, say 'Board'\n   To leave boat, say 'Disembark'\n\n   To get into a body of water, say 'Launch'\n   To get to shore, say 'Land'\n    \nWarranty:\n\n  This boat is guaranteed against all defects in parts and\nworkmanship for a period of 76 milliseconds from date of purchase or\nuntil first used, whichever comes first.\n\nWarning:\n   This boat is made of plastic.\t\tGood Luck!\n"},
    {oid: "THIEF", syns: ["THIEF", "ROBBE", "CROOK", "CRIMI", "BANDI", "GENT", "GENTL", "MAN", "INDIV"], adj: ["SHADY", "SUSPI"], desc: "thief", bits: ["ovison", "vicbit", "villain"], objfn: "robber_function", contents: ["STILL"], is_global: false, odesc1: "There is a suspicious-looking individual, holding a bag, leaning\nagainst one wall.  He is armed with a vicious-looking stiletto.", ostrength: 5, ofmsgs: "&thief_melee"},
    {oid: "SAFFR", syns: ["SAFFR", "TIN", "SPICE"], adj: ["RARE"], desc: "tin of spices", bits: ["takebit"], objfn: null, contents: [], is_global: false, odesc1: "There is a tin of rare spices here.", osize: 8, ofval: 5, otval: 5},
    {oid: "TORCH", syns: ["TORCH", "IVORY"], adj: ["IVORY"], desc: "torch", bits: ["ovison", "takebit", "lightbit", "flamebit", "toolbit", "onbit"], objfn: "torch_object", contents: [], is_global: false, odesco: "Sitting on the pedestal is a flaming torch, made of ivory.", odesc1: "There is an ivory torch here.", osize: 20, ofval: 14, otval: 6},
    {oid: "GUIDE", syns: ["GUIDE", "BOOK"], adj: ["TOUR"], desc: "tour guidebook", bits: ["ovison", "readbit", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesco: "Some guidebooks entitled 'Flood Control Dam #3' are on the reception\ndesk.", odesc1: "There are tour guidebooks here.", oread: "\"\t\t   Guide Book to\n\t\tFlood Control Dam #3\n\n  Flood Control Dam #3 (FCD#3) was constructed in year 783 of the\nGreat Underground Empire to harness the destructive power of the\nFrigid River.  This work was supported by a grant of 37 million\nzorkmids from the Central Bureaucracy and your omnipotent local\ntyrant Lord Dimwit Flathead the Excessive. This impressive\nstructure is composed of 3.7 cubic feet of concrete, is 256 feet\ntall at the center, and 193 feet wide at the top.  The reservoir\ncreated behind the dam has a volume of 37 billion cubic feet, an\narea of 12 million square feet, and a shore line of 36 thousand\nfeet.\n\n  The construction of FCD#3 took 112 days from ground breaking to\nthe dedication. It required a work force of 384 slaves, 34 slave\ndrivers, 12 engineers, 2 turtle doves, and a partridge in a pear\ntree. The work was managed by a command team composed of 2345\nbureaucrats, 2347 secretaries (at least two of whom can type),\n12,256 paper shufflers, 52,469 rubber stampers, 245,193 red tape\nprocessors, and nearly one million dead trees.\n\n  We will now point out some of the more interesting features\nof FCD#3 as we conduct you on a guided tour of the facilities:\n\t1) You start your tour here in the Dam Lobby.\n\t   You will notice on your right that ........."},
    {oid: "TROLL", syns: ["TROLL"], adj: ["NASTY"], desc: "troll", bits: ["ovison", "vicbit", "villain"], objfn: "troll", contents: ["AXE"], is_global: false, odesc1: "A nasty-looking troll, brandishing a bloody axe, blocks all passages\nout of the room.", ostrength: 2, ofmsgs: "&troll_melee"},
    {oid: "TCASE", syns: ["TCASE", "CASE"], adj: ["TROPH"], desc: "trophy case", bits: ["ovison", "transbit", "contbit"], objfn: "trophy_case", contents: [], is_global: false, odesc1: "There is a trophy case here.", ocapac: "bigfix"},
    {oid: "TRUNK", syns: ["TRUNK", "CHEST", "JEWEL"], adj: ["OLD"], desc: "trunk of jewels", bits: ["takebit"], objfn: null, contents: [], is_global: false, odesco: "Lying half buried in the mud is an old trunk, bulging with jewels.", odesc1: "There is an old trunk here, bulging with assorted jewels.", osize: 35, ofval: 15, otval: 8},
    {oid: "TUBE", syns: ["TUBE", "TOOTH"], adj: [], desc: "tube", bits: ["ovison", "takebit", "contbit", "readbit"], objfn: "tube_function", contents: ["PUTTY"], is_global: false, odesc1: "There is an object which looks like a tube of toothpaste here.", ocapac: 7, osize: 10, oread: "---> Frobozz Magic Gunk Company <---\n\t  All-Purpose Gunk"},
    {oid: "PUTTY", syns: ["PUTTY", "MATER", "GUNK", "GLUE"], adj: ["VISCO"], desc: "viscous material", bits: ["ovison", "takebit", "toolbit"], objfn: null, contents: [], is_global: false, odesc1: "There is some gunk here", osize: 6},
    {oid: "ENGRA", syns: ["ENGRA", "INSCR"], adj: ["OLD", "ANCIE"], desc: "wall with engravings", bits: ["ovison", "readbit", "sacredbit"], objfn: null, contents: [], is_global: false, odesc1: "There are old engravings on the walls here.", oread: "The engravings were incised in the living rock of the cave wall by\nan unknown hand.  They depict, in symbolic form, the beliefs of the\nancient peoples of Zork.  Skillfully interwoven with the bas reliefs\nare excerpts illustrating the major tenets expounded by the sacred\ntexts of the religion of that time.  Unfortunately a later age seems\nto have considered them blasphemous and just as skillfully excised\nthem."},
    {oid: "ETCH2", syns: ["ETCH2", "ETCHI", "WALLS", "WALL"], adj: [], desc: "wall with etchings", bits: ["ovison", "readbit", "ndescbit", "findmebit"], objfn: null, contents: [], is_global: false, oread: "\t\t        o  b  o\n\t\t    r \t\t  z\n\t\t f   M  A  G  I  C   z\n\t\t c    W  E   L  L    y\n\t\t    o\t\t  n\n\t\t        m  p  a\n"},
    {oid: "ETCH1", syns: ["ETCH1", "ETCHI", "WALLS", "WALL"], adj: [], desc: "wall with etchings", bits: ["ovison", "readbit", "ndescbit", "findmebit"], objfn: null, contents: [], is_global: false, oread: "\t\t        o  b  o\n\n\t\t        A  G  I\n\t\t         E   L\n\n\t\t        m  p  a\n"},
