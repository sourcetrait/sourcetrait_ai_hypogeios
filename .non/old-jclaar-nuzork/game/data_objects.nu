    {oid: "ROPE", syns: ["ROPE", "HEMP", "COIL"], adj: ["LARGE"], desc: "rope", bits: ["ovison", "takebit", "tiebit", "sacredbit"], objfn: "rope_function", contents: [], is_global: false, odesco: "A large coil of rope is lying in the corner.", odesc1: "There is a large coil of rope here.", osize: 10},
    {oid: "RUBY", syns: ["RUBY"], adj: ["MOBY"], desc: "ruby", bits: ["ovison", "takebit"], objfn: null, contents: [], is_global: false, odesco: "On the floor lies a moby ruby.", odesc1: "There is a moby ruby lying here.", ofval: 15, otval: 8},
