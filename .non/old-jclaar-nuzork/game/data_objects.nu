    {oid: "GRATE", syns: ["GRATE", "GRATI"], adj: [], desc: "grating", bits: ["ovison", "doorbit", "ndescbit"], objfn: "grate_function", contents: [], is_global: false},
    {oid: "GRBK", syns: ["GRBK", "BOOK"], adj: ["GREEN"], desc: "green book", bits: ["ovison", "readbit", "takebit", "contbit", "burnbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a green book here.", ocapac: 2, osize: 10, oread: "This book is written in a tongue with which I am unfamiliar."},
    {oid: "RBTLB", syns: ["RBTLB", "PAPER", "PIECE"], adj: ["GREEN"], desc: "green piece of paper", bits: ["ovison", "readbit", "takebit", "burnbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a green piece of paper here.", osize: 3, oread: "\t  !!!! \tFROBOZZ MAGIC ROBOT COMPANY  !!!!\n\nHello, Master!\n   \n   I am a late-model robot, trained at MIT Tech to perform various\nsimple household functions. \n\nInstructions for use:\n   To activate me, use the following formula:\n\t>TELL ROBOT '<something to do>' <cr>\n   The quotation marks are required!\n       \nWarranty:\n   No warranty is expressed or implied.\n\t\t\t\t\n\t\t\t\t\tAt your service!\n"},
    {oid: "PUMP", syns: ["PUMP", "AIR-P", "AIRPU"], adj: ["SMALL", "HAND-"], desc: "hand-held air pump", bits: ["ovison", "takebit", "toolbit"], objfn: null, contents: [], is_global: false, odesc1: "There is a small pump here."},
