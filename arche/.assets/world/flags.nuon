[
    { name: "actor", preserved: "ACTORBIT", summary: "Marks an object as a living creature, so combat, give, and talk verbs accept it as a target.", state: null },
    { name: "burn", preserved: "BURNBIT", summary: "Marks an object as flammable, so it can be set alight and consumed by burning.", state: null },
    { name: "climb", preserved: "CLIMBBIT", summary: "Marks an object that can be climbed up, down, or on.", state: null },
    { name: "container", preserved: "CONTBIT", summary: "Marks an object that can hold other objects inside it.", state: null },
    { name: "door", preserved: "DOORBIT", summary: "Marks an object as a door or lid that can be opened and closed.", state: null },
    { name: "drink", preserved: "DRINKBIT", summary: "Marks an object that can be drunk.", state: null },
    { name: "fighting", preserved: "FIGHTBIT", summary: "Tracks that a creature is currently engaged in active combat, set and cleared as fights begin and end.", state: { default: false, scope: ["actor"] } },
    { name: "flame", preserved: "FLAMEBIT", summary: "Marks an object that is currently burning with an open flame usable to light or ignite other things.", state: { default: false, scope: ["object"] } },
    { name: "food", preserved: "FOODBIT", summary: "Marks an object that can be eaten.", state: null },
    { name: "invisible", preserved: "INVISIBLE", summary: "Hides an object from the player, excluding it from room listings and parser resolution until revealed.", state: { default: false, scope: ["object"] } },
    { name: "light_source", preserved: "LIGHTBIT", summary: "Marks an object that is a controllable lamp able to be turned on and off.", state: { default: false, scope: ["object"] } },
    { name: "maze", preserved: "MAZEBIT", summary: "Marks a room as part of the maze, altering navigation and the thief's roaming behavior there.", state: null },
    { name: "no_description", preserved: "NDESCBIT", summary: "Suppresses the automatic mention of an object in a room's contents listing.", state: { default: false, scope: ["object"] } },
    { name: "non_land", preserved: "NONLANDBIT", summary: "Marks a room as water rather than dry land, requiring a watercraft to occupy it.", state: { default: false, scope: ["room"] } },
    { name: "nwall", preserved: "NWALLBIT", summary: "Zork II room marker; appears only in room FLAGS and is never tested in the preserved source, so its purpose is unrecorded.", state: null },
    { name: "lighting", preserved: "ONBIT", summary: "Tracks that a lamp or room is currently lit or switched on.", state: { default: false, scope: ["room", "object"] } },
    { name: "open", preserved: "OPENBIT", summary: "Tracks that a door or container is currently open.", state: { default: false, scope: ["object"] } },
    { name: "read", preserved: "READBIT", summary: "Marks an object bearing text that can be read.", state: { default: false, scope: ["object"] } },
    { name: "land", preserved: "RLANDBIT", summary: "Marks a room as dry land that can be entered on foot.", state: { default: false, scope: ["room"] } },
    { name: "mung", preserved: "RMUNGBIT", summary: "Marks a room or object as destroyed or ruined, replacing its normal description and disabling its function.", state: { default: false, scope: ["room", "object"] } },
    { name: "sacred", preserved: "SACREDBIT", summary: "Protects a room or object from the thief, who will neither enter it nor steal from it.", state: { default: false, scope: ["room", "object"] } },
    { name: "search", preserved: "SEARCHBIT", summary: "Marks an object whose contents are revealed when it is searched or looked inside.", state: null },
    { name: "staggered", preserved: "STAGGERED", summary: "Tracks that a combatant is reeling from a blow and loses its next turn, cleared once that turn passes.", state: { default: false, scope: ["actor"] } },
    { name: "surface", preserved: "SURFACEBIT", summary: "Marks an object as a surface that other objects can be placed on top of.", state: null },
    { name: "take", preserved: "TAKEBIT", summary: "Marks an object that the player can pick up and carry.", state: { default: false, scope: ["object"] } },
    { name: "tool", preserved: "TOOLBIT", summary: "Marks an object usable as an instrument for actions such as digging, prying, locking, or turning.", state: null },
    { name: "touch", preserved: "TOUCHBIT", summary: "Tracks that a room has been visited or an object disturbed, distinguishing first encounters from later ones.", state: { default: false, scope: ["room", "object"] } },
    { name: "transparent", preserved: "TRANSBIT", summary: "Marks a container whose contents are visible even while it is closed.", state: null },
    { name: "try_take", preserved: "TRYTAKEBIT", summary: "Marks an object the parser will attempt to pick up automatically before a verb that needs it held.", state: { default: false, scope: ["object"] } },
    { name: "turn", preserved: "TURNBIT", summary: "Marks an object that can be turned, such as a switch, dial, or bolt.", state: null },
    { name: "vehicle", preserved: "VEHBIT", summary: "Marks an object that can be boarded and ridden, carrying the player between rooms.", state: { default: false, scope: ["object"] } },
    { name: "victim", preserved: "VICBIT", summary: "Marks an object as a valid victim/target for attack-style verbs like KNOCK DOWN, in Zork III.", state: null },
    { name: "weapon", preserved: "WEAPONBIT", summary: "Marks an object usable as a weapon in combat.", state: { default: false, scope: ["object"] } },
    { name: "wear", preserved: "WEARBIT", summary: "Marks an object that can be worn.", state: null }
]
